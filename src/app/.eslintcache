[{"/src/src/app/src/App.js":"1","/src/src/app/src/reportWebVitals.js":"2","/src/src/app/src/index.js":"3","/src/src/app/src/services/todoApi.js":"4"},{"size":2245,"mtime":1793452971420,"results":"5","hashOfConfig":"6"},{"size":375,"mtime":1793382879823,"results":"7","hashOfConfig":"6"},{"size":517,"mtime":1793382879822,"results":"8","hashOfConfig":"6"},{"size":619,"mtime":1793453510256,"results":"9","hashOfConfig":"6"},{"filePath":"10","messages":"11","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"12"},"pbbam4",{"filePath":"13","messages":"14","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"15","messages":"16","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"17","messages":"18","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/src/src/app/src/App.js",["19"],"import './App.css';\r\nimport logo from './logo.svg';\r\nimport { useState } from 'react';\r\nimport { useEffect } from 'react';\r\nimport { fetchTodos, createTodo } from './services/todoApi';\r\n\r\nexport function App() {\r\n  const [todos, setTodos] = useState([]);\r\n  const [title, setTitle] = useState('');\r\n  const [loading, setLoading] = useState(true);\r\nconst [error, setError] = useState('');\r\nconst [submitting, setSubmitting] = useState(false);\r\nuseEffect(() => {\r\n  const loadTodos = async () => {\r\n    try {\r\n      const data = await fetchTodos();\r\n      setTodos(data);\r\n    } catch (err) {\r\n      setError(err.message);\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  loadTodos();\r\n}, []);\r\n  const handleSubmit = async (event)=>{\r\n\r\n    event.preventDefault();\r\n\r\n    const trimmedTitle = title.trim();\r\n    if (!trimmedTitle) {\r\n      setError('TODO title cannot be empty.');\r\n    return;\r\n  }\r\n    try {\r\n    setError('');\r\n    setSubmitting(true);\r\n\r\n    await createTodo({ title: trimmedTitle });\r\n\r\n    // Fetch the latest list from the backend.\r\n    const updatedTodos = await fetchTodos();\r\n    setTodos(updatedTodos);\r\n\r\n    setTitle('');\r\n  } catch (err) {\r\n    setError(err.message);\r\n  } finally {\r\n    setSubmitting(false);\r\n  }\r\n};\r\n  return (\r\n    <div className=\"App\">\r\n      <div>\r\n        <h1>List of TODOs</h1>\r\n        {loading && <p>Loading TODOs...</p>}\r\n\r\n  {error && <p>{error}</p>}\r\n\r\n  {!loading && !error && todos.length === 0 && (\r\n    <p>No TODOs found.</p>\r\n  )}\r\n\r\n  {!loading && !error && (\r\n    <ol className=\"todo-list\">\r\n      {todos.map((todo) => (\r\n        <li key={todo.id}>{todo.title}</li>\r\n      ))}\r\n    </ol>\r\n  )}\r\n      </div>\r\n      <div>\r\n        <h1>Create a ToDo</h1>\r\n        <form onSubmit={handleSubmit}>\r\n          <div>\r\n            <label htmlFor=\"todo\">ToDo: </label>\r\n            <input id=\"todo\"type=\"text\" value={title} onChange={(event)=>setTitle(event.target.value)} />\r\n          </div>\r\n          <div style={{\"marginTop\": \"5px\"}}>\r\n            <button type=\"submit\" disabled={submitting}>\r\n              {submitting ? 'Adding ToDo...' : 'Add ToDo!'}\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default App;\r\n","/src/src/app/src/reportWebVitals.js",[],"/src/src/app/src/index.js",[],"/src/src/app/src/services/todoApi.js",[],{"ruleId":"20","severity":1,"message":"21","line":2,"column":8,"nodeType":"22","messageId":"23","endLine":2,"endColumn":12},"no-unused-vars","'logo' is defined but never used.","Identifier","unusedVar"]